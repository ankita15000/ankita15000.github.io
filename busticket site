function timeToMins(t) {
  const [time, p] = t.split(' ');
  let [h, m] = time.split(':').map(Number);
  if (p==='PM' && h!==12) h+=12;
  if (p==='AM' && h===12) h=0;
  return h*60+m;
}

function addDuration(t, dur) {
  const m = timeToMins(t);
  const d = dur.match(/(\d+)h\s+(\d+)m/);
  const add = parseInt(d[1])*60 + parseInt(d[2]);
  const tot = m + add;
  const nd = tot >= 1440;
  const hh = Math.floor((tot%1440)/60);
  const mm = tot%60;
  const p = hh>=12?'PM':'AM';
  const h12 = hh%12||12;
  return `${h12}:${mm.toString().padStart(2,'0')} ${p}${nd?' +1':''}`;
}

function dynPrice(base, i) {
  const mults=[1,1,1.1,1.2,1.15,1.05,1.3,1,1.25,1.1,1,0.95];
  return Math.round(base*(mults[i%mults.length]||1));
}

function seatAvail(i, h) {
  const s=(i*7+h)%10;
  if(s<3) return {label:'Limited (< 5)',cls:'limited'};
  if(s<6) return {label:'Few Left',cls:'few'};
  return {label:'Available',cls:'many'};
}

function tripType(dep) {
  const h = timeToMins(dep)/60;
  if(h>=22||h<5) return 'Overnight';
  if(h>=18) return 'Evening';
  if(h>=12) return 'Afternoon';
  return 'Morning';
}

function searchSchedules() {
  const from = document.getElementById('fromCity').value;
  const to   = document.getElementById('toCity').value;
  const date = document.getElementById('travelDate').value;
  if(!from){alert('Please select a departure city.');return;}
  if(!to){alert('Please select a destination city.');return;}
  if(!date){alert('Please select a travel date.');return;}
  if(from===to){alert('Departure and destination cannot be the same.');return;}

  const ra = document.getElementById('resultsArea');
  ra.classList.add('visible');
  document.getElementById('loadingState').style.display='block';
  document.getElementById('resultsContent').style.display='none';
  document.getElementById('noResults').style.display='none';
  document.getElementById('callBanner').classList.remove('visible');
  setTimeout(()=>ra.scrollIntoView({behavior:'smooth',block:'start'}),100);

  setTimeout(()=>{
    document.getElementById('loadingState').style.display='none';
    const route = SCHEDULES[`${from}|${to}`];
    if(!route){document.getElementById('noResults').style.display='block';return;}

    const fd = new Date(date+'T12:00:00').toLocaleDateString('en-US',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
    document.getElementById('resultsTitle').textContent=`${from} → ${to}`;
    document.getElementById('resultsCount').textContent=`${route.departures.length} departures found · ${fd}`;

    const tbody = document.getElementById('schedulesBody');
    tbody.innerHTML='';
    route.departures.forEach((dep,i)=>{
      const arr=addDuration(dep,route.duration);
      const price=dynPrice(route.basePrice,i);
      const seats=seatAvail(i,Math.floor(timeToMins(dep)/60));
      const type=tripType(dep);
      const [dt,dp]=dep.split(' ');
      const arrParts=arr.split(' ');
      const [at,...ap]=arrParts;
      const tr=document.createElement('tr');
      tr.innerHTML=`
        <td data-label="Departs"><span class="time-badge">${dt}<span class="period">${dp}</span></span></td>
        <td data-label="Arrives"><span class="time-badge">${at}<span class="period">${ap.join(' ')}</span></span></td>
        <td data-label="Duration"><span class="duration-pill">🕐 ${route.duration}</span></td>
        <td data-label="Type"><span style="font-size:0.82rem;color:var(--gray);font-weight:500;">${type}</span><span class="trip-type-badge">Greyhound</span></td>
        <td data-label="Price"><span class="price-tag">$${price} <span>/ person</span></span></td>
        <td data-label="Seats"><span class="seat-badge ${seats.cls}">${seats.label}</span></td>
        <td data-label="Book"><a href="tel:+18005550199" class="book-call-btn"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.67A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>Book This</a></td>
      `;
      tbody.appendChild(tr);
    });
    document.getElementById('resultsContent').style.display='block';
    document.getElementById('callBanner').classList.add('visible');
  }, 1400);
}

function prefillRoute(from, to) {
  document.getElementById('fromCity').value=from;
  document.getElementById('toCity').value=to;
  const tmr=new Date(); tmr.setDate(tmr.getDate()+1);
  document.getElementById('travelDate').value=tmr.toISOString().split('T')[0];
  document.getElementById('schedule-search').scrollIntoView({behavior:'smooth'});
}

